# ─────────────────────────────────────────────────────────────
# Youth Policy Lab — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix) on purpose.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical links, sitemap, citations, social cards)
SITE_URL=http://localhost:3000

# ── Supabase (applications, contact messages, CMS content, PDF storage)
# Project Settings → API. The service-role key bypasses row-level security,
# so it must only ever live on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for PDFs / cover images (created by supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=publications

# ── Admin dashboard (/admin)
# ADMIN_PASSWORD is the "owner" login (always full admin). Use it to create
# individual reviewer/editor accounts under Admin → Admin accounts.
# ADMIN_SESSION_SECRET signs sessions — generate with:  openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Email notifications (optional) — https://resend.com
# NOTIFY_FROM must use a domain you have verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM="Youth Policy Lab <notifications@yourdomain.org>"
# Comma-separated team inbox(es) that receive new-application / message alerts
NOTIFY_EMAIL=
# Also email applicants a "we received your application" confirmation
NOTIFY_SEND_CONFIRMATION=false

# ── Spam protection (optional) — Cloudflare Turnstile
# dash.cloudflare.com → Turnstile → Add site. Both keys are needed to enable it.
# The site key is read at build time: redeploy after changing it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI assistant (Claude API)
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
