# ─────────────────────────────────────────────────────────────
# Youth Policy Lab — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix) on purpose.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical links, sitemap, citations, social cards)
SITE_URL=http://localhost:3000

# ── Supabase (applications, contact messages, CMS content, PDF storage)
# Project Settings → API. The service-role key bypasses row-level security,
# so it must only ever live on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for PDFs / cover images (created by supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=publications

# ── Admin dashboard (/admin)
# Shared reviewer password + a long random secret used to sign sessions.
# Generate a secret with:  openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── AI assistant (Claude API)
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
